{
  "name": "ai-workforce-saas",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual (ar/en) multi-tenant AI Workforce SaaS — Knowledge, Creative and Advertising agents over n8n",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "openapi": "tsx scripts/generate-openapi.ts",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@eslint/eslintrc": "^3.3.7",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.25",
    "next-intl": "^4.14.2",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0-beta.8",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4.0.0-beta.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
