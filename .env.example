# ---------------------------------------------------------------------------
# AI Workforce SaaS — environment configuration
#
# Copy to `.env` for local development. Every variable below is validated at
# boot by src/server/config/env.ts; the process refuses to start in production
# if a required secret is missing or too weak. Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# Public origin of the SaaS. Used to build absolute callback URLs handed to n8n
# and to enforce the Origin check on state-changing API requests (CSRF defence).
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_workforce
# Connection pool size per app instance.
DATABASE_POOL_MAX=10

# --- Secrets ----------------------------------------------------------------
# 32+ bytes of base64 randomness each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Signs session cookies and single-use tokens (email verification, password reset).
AUTH_SECRET=
# Encrypts integration credentials at rest (AES-256-GCM). Rotating this requires
# re-encrypting the integrations table — see docs/security.md.
ENCRYPTION_KEY=

# --- n8n Agent Gateway ------------------------------------------------------
# Base URL of the n8n instance. The SaaS backend is the ONLY thing that talks to
# it; these values are never exposed to the browser.
N8N_BASE_URL=https://fsb.tyc.mybluehost.me
# Optional bearer/header auth if the n8n webhooks are protected.
N8N_WEBHOOK_AUTH_HEADER=
N8N_WEBHOOK_AUTH_VALUE=

# Chat-trigger webhook IDs, discovered from the live workflows.
# See docs/agent-contracts.md for the full contract of each.
N8N_KNOWLEDGE_WEBHOOK_ID=bba97385-5d58-421b-b1b4-693ff678ac83
N8N_CREATIVE_WEBHOOK_ID=8f794ade-d341-404e-926e-761c859069fc
N8N_ADVERTISING_WEBHOOK_ID=700fca75-371c-4d73-8323-7058edb3e6cd

# Workflow IDs (used only for operator-facing links and health reporting).
N8N_KNOWLEDGE_WORKFLOW_ID=pOwwQdXNflGHVaV8
N8N_CREATIVE_WORKFLOW_ID=7GYulsPGi7WFpJzx
N8N_ADVERTISING_WORKFLOW_ID=Pm3x6FweL5opKlj0

# How long the gateway waits on a synchronous agent call before failing the job.
N8N_REQUEST_TIMEOUT_MS=300000

# Shared secret for the n8n -> SaaS callback endpoint (/api/v1/webhooks/n8n).
# Callbacks are HMAC-SHA256 signed and replay-protected. Comma-separated list
# allows zero-downtime rotation: the first value signs, all values verify.
N8N_CALLBACK_SECRETS=

# --- Object storage (S3-compatible) -----------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-workforce-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO and most self-hosted gateways need path-style addressing.
S3_FORCE_PATH_STYLE=true
# Lifetime of presigned download URLs handed to the browser.
S3_SIGNED_URL_TTL_SECONDS=900

# --- Redis (optional) -------------------------------------------------------
# When unset, rate limiting falls back to the Postgres-backed limiter, which is
# correct but slower. Set this for multi-instance deployments.
REDIS_URL=

# --- Email ------------------------------------------------------------------
# Transport for verification and password-reset mail. When EMAIL_TRANSPORT=log
# (the default in development) messages are written to the structured log
# instead of being sent; no mail is silently dropped.
EMAIL_TRANSPORT=log
EMAIL_FROM=no-reply@example.com
SMTP_URL=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-workforce-saas

# --- Localization -----------------------------------------------------------
# Fallback when the browser sends neither Arabic nor English.
DEFAULT_LOCALE=ar
